# Gerar com:
#   openssl rand -base64 32
CONNECT_MASTER_KEY=

# Gerar com:
#   openssl rand -hex 32
ADMIN_TOKEN=

# Server
SERVER_ADDR=:9090
LOG_LEVEL=info
LOG_FORMAT=json

# Database (compose já popula via env no docker-compose.yml, mas para
# rodar o binário fora do compose, precisa apontar pro host)
# DATABASE_URL=postgres://connect:connect@localhost:5432/evogo_connect?sslmode=disable

BRIDGE_PAUSED=false
RATE_LIMIT_PER_MINUTE=120
IDEMPOTENCY_TTL=24h
HMAC_REPLAY_WINDOW=5m
