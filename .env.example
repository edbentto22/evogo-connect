# ─── Server ───────────────────────────────────────────────────────────────
SERVER_ADDR=:9090
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
LOG_LEVEL=info
LOG_FORMAT=json

# ─── Database ─────────────────────────────────────────────────────────────
# Connect string do Postgres. Use o Postgres do docker-compose ou externo.
DATABASE_URL=postgres://connect:connect@localhost:5432/evogo_connect?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1

# ─── Security ─────────────────────────────────────────────────────────────
# Chave mestra AES-256 (32 bytes em base64). GERE UMA NOVA PARA PRODUÇÃO.
# Exemplo: openssl rand -base64 32
CONNECT_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES_AAAAAAAAAAAAAAAAAAAAAAAA=

# Token de admin para /admin/* endpoints. GERE UM FORTE.
ADMIN_TOKEN=change-me-to-a-random-secret

# Kill switch: quando true, webhooks retornam 503 imediatamente
BRIDGE_PAUSED=false

# ─── Rate limit ───────────────────────────────────────────────────────────
# Mensagens por minuto por (inbox_id, direction)
RATE_LIMIT_PER_MINUTE=120

# ─── Idempotência ─────────────────────────────────────────────────────────
# Tempo de retenção das chaves de idempotência
IDEMPOTENCY_TTL=24h

# ─── HMAC tolerância (replay protection) ─────────────────────────────────
HMAC_REPLAY_WINDOW=5m
